{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Speaker turns (Gemini response text for the speakers task)",
  "type": "object",
  "required": ["turns"],
  "properties": {
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "position"],
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "position": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

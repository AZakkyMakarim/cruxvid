{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transcript",
  "type": "object",
  "required": ["language", "words"],
  "properties": {
    "language": { "type": "string" },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "start", "end"],
        "properties": {
          "text": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
